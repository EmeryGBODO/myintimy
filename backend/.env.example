APP_NAME=Myintimy API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://myintimy:myintimy@localhost:5432/myintimy
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-secret-before-production
ADMIN_ACCESS_TOKEN_MINUTES=480
MEDIA_ROOT=media
MAX_PRODUCT_IMAGE_BYTES=5242880

# Configuration SMTP / Emails transactionnels
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
MAIL_FROM_EMAIL=contact@myintimy.com
# Destinataires administrateur pour les alertes de commandes (adresses uniques ou multiples séparées par des virgules)
MAIL_ADMIN_EMAIL=admin@myintimy.com,commandes@myintimy.com
FRONTEND_URL=http://localhost:5173
