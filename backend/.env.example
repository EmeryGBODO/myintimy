APP_NAME=Myintimy API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://myintimy:myintimy@localhost:5432/myintimy
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-secret-before-production
ADMIN_ACCESS_TOKEN_MINUTES=480
MEDIA_ROOT=media
MAX_PRODUCT_IMAGE_BYTES=5242880
CUSTOMER_ACCESS_TOKEN_MINUTES=10080
CUSTOMER_PASSWORD_RESET_MINUTES=30
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=true
PAYMENT_SESSION_MINUTES=15
PAYMENT_VERIFY_MAX_ATTEMPTS=10
PAYMENT_RECONCILE_BATCH_SIZE=100
AUTH_COOKIE_SAMESITE=lax
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=600
CUSTOMER_LOGIN_MAX_ATTEMPTS=8
CUSTOMER_LOGIN_WINDOW_SECONDS=600
CUSTOMER_REGISTER_MAX_ATTEMPTS=5
CUSTOMER_REGISTER_WINDOW_SECONDS=3600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_WINDOW_SECONDS=3600
PAYMENT_VERIFY_IP_MAX_ATTEMPTS=20
PAYMENT_VERIFY_IP_WINDOW_SECONDS=600

# Configuration SMTP / Emails transactionnels
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
MAIL_FROM_EMAIL=contact@myintimy.com
MAIL_ADMIN_EMAIL=admin@myintimy.com,commandes@myintimy.com
FRONTEND_URL=http://localhost:5173